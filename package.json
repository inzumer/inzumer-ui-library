{
  "name": "ui-library",
  "private": true,
  "version": "0.0.0",
  "description": "Inzumer Design System monorepo",
  "license": "MIT",
  "author": "Nahuel Zamuner <inzumer@gmail.com>",
  "homepage": "https://github.com/inzumer/ui-library#readme",
  "bugs": {
    "url": "https://github.com/inzumer/ui-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inzumer/ui-library.git"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,mdx}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,mdx}\" --ignore-path .gitignore",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "turbo run build && changeset publish",
    "clean": "turbo run clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@inzumer/eslint-config": "workspace:*",
    "@inzumer/prettier-config": "workspace:*",
    "@inzumer/tsconfig": "workspace:*",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-actions": "^8.6.18",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-toolbars": "^8.6.18",
    "@storybook/addon-viewport": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/manager-api": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@storybook/theming": "^8.6.18",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "prettier": "^3.4.2",
    "react": ">=18 || ^19",
    "react-dom": ">=18 || ^19",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.19",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
