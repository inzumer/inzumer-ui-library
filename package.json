{
  "name": "inzumer-ui-library",
  "private": true,
  "version": "0.0.0",
  "description": "Inzumer Design System monorepo",
  "license": "MIT",
  "author": "Nahuel Zamuner <inzumer@gmail.com>",
  "homepage": "https://github.com/inzumer/inzumer-ui-library#readme",
  "bugs": {
    "url": "https://github.com/inzumer/inzumer-ui-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inzumer/inzumer-ui-library.git"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,mdx}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,mdx}\" --ignore-path .gitignore",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "turbo run build && changeset publish",
    "clean": "turbo run clean && node -e \"require('fs').rmSync('node_modules',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@inzumer/eslint": "^1.1.0",
    "@inzumer/prettier": "^1.0.0",
    "@inzumer/tokens": "^1.2.0",
    "@inzumer/tsconfig": "^1.0.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-actions": "^9.0.8",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-toolbars": "^8.6.18",
    "@storybook/addon-viewport": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/manager-api": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@storybook/theming": "^8.6.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "react": ">=19",
    "react-dom": ">=19",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.5",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=3.0.0 <5.0.12": "^5.0.12",
      "js-yaml@<3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.23": "^8.5.23",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "uuid@<11.1.1": "^11.1.1",
      "esbuild@<0.25.0": "^0.25.0",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.1"
    }
  }
}
