# Dependencies
# pnpm symlinks + the local content-addressable store cache live here.
node_modules/

# Build outputs
# Generated by tsup (packages/ui) and tsc.
dist/
.tsc-out/
*.tsbuildinfo

# Storybook
# Static build produced by `pnpm build-storybook`.
storybook-static/

# Tests / coverage
coverage/

# Turborepo
# Local task cache: root .turbo/cache (cached outputs per task hash) and
# per-package .turbo/turbo-<task>.log (last run's log). Regenerates on every
# `pnpm build|test|typecheck` run — never needs to be committed.
.turbo/

# Lint cache
.eslintcache

# Package publishing
# Tarballs from `pnpm pack`, used to test the library locally before publishing.
*.tgz

# Logs
pnpm-debug.log*

# Environment variables
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.local
.playwright-mcp/

# Project-specific
# Planning docs are working notes, not meant to be versioned.
docs/plans/
