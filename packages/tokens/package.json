{
  "name": "@inzumer/tokens",
  "version": "1.1.0",
  "private": false,
  "description": "Design tokens, theming, and Tailwind preset for the Inzumer design system",
  "license": "MIT",
  "author": "Nahuel Zamuner <inzumer@gmail.com>",
  "homepage": "https://github.com/inzumer/ui-library/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/inzumer/ui-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inzumer/ui-library.git",
    "directory": "packages/tokens"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "tailwindcss",
    "theming",
    "css-variables"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/tailwind/preset.d.ts",
      "import": "./dist/tailwind/preset.js"
    },
    "./css/reset": "./dist/css/reset.css",
    "./css/variables": "./dist/css/variables.css",
    "./css/typography": "./dist/css/typography.css",
    "./css/scrollbar": "./dist/css/scrollbar.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && pnpm run build:css",
    "build:css": "node -e \"require('fs').cpSync('src/css','dist/css',{recursive:true})\"",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "peerDependencies": {
    "react": ">=18 || ^19",
    "react-dom": ">=18 || ^19"
  },
  "devDependencies": {
    "@inzumer/eslint-config": "workspace:*",
    "@inzumer/tsconfig": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.6"
  }
}
