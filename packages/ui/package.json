{
  "name": "@inzumer/ui-library",
  "version": "1.5.0",
  "private": false,
  "description": "React UI component library for the Inzumer design system",
  "license": "MIT",
  "author": "Nahuel Zamuner <inzumer@gmail.com>",
  "homepage": "https://github.com/inzumer/ui-library/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/inzumer/ui-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inzumer/ui-library.git",
    "directory": "packages/ui"
  },
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "ui",
    "tailwindcss",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/components/atoms/Button/index.d.ts",
      "import": "./dist/components/atoms/Button/index.js"
    },
    "./icon": {
      "types": "./dist/components/atoms/Icon/index.d.ts",
      "import": "./dist/components/atoms/Icon/index.js"
    },
    "./image": {
      "types": "./dist/components/atoms/Image/index.d.ts",
      "import": "./dist/components/atoms/Image/index.js"
    },
    "./input": {
      "types": "./dist/components/atoms/Input/index.d.ts",
      "import": "./dist/components/atoms/Input/index.js"
    },
    "./link": {
      "types": "./dist/components/atoms/Link/index.d.ts",
      "import": "./dist/components/atoms/Link/index.js"
    },
    "./rich-text": {
      "types": "./dist/components/atoms/RichText/index.d.ts",
      "import": "./dist/components/atoms/RichText/index.js"
    },
    "./select": {
      "types": "./dist/components/atoms/Select/index.d.ts",
      "import": "./dist/components/atoms/Select/index.js"
    },
    "./switch": {
      "types": "./dist/components/atoms/Switch/index.d.ts",
      "import": "./dist/components/atoms/Switch/index.js"
    },
    "./textarea": {
      "types": "./dist/components/atoms/Textarea/index.d.ts",
      "import": "./dist/components/atoms/Textarea/index.js"
    },
    "./accordion": {
      "types": "./dist/components/molecules/Accordion/index.d.ts",
      "import": "./dist/components/molecules/Accordion/index.js"
    },
    "./bottom-sheet": {
      "types": "./dist/components/molecules/BottomSheet/index.d.ts",
      "import": "./dist/components/molecules/BottomSheet/index.js"
    },
    "./breadcrumbs": {
      "types": "./dist/components/molecules/Breadcrumbs/index.d.ts",
      "import": "./dist/components/molecules/Breadcrumbs/index.js"
    },
    "./card": {
      "types": "./dist/components/molecules/Card/index.d.ts",
      "import": "./dist/components/molecules/Card/index.js"
    },
    "./carousel": {
      "types": "./dist/components/molecules/Carousel/index.d.ts",
      "import": "./dist/components/molecules/Carousel/index.js"
    },
    "./cookie-banner": {
      "types": "./dist/components/molecules/CookieBanner/index.d.ts",
      "import": "./dist/components/molecules/CookieBanner/index.js"
    },
    "./cookie-preferences": {
      "types": "./dist/components/molecules/CookiePreferences/index.d.ts",
      "import": "./dist/components/molecules/CookiePreferences/index.js"
    },
    "./drawer": {
      "types": "./dist/components/molecules/Drawer/index.d.ts",
      "import": "./dist/components/molecules/Drawer/index.js"
    },
    "./dropdown": {
      "types": "./dist/components/molecules/Dropdown/index.d.ts",
      "import": "./dist/components/molecules/Dropdown/index.js"
    },
    "./language": {
      "types": "./dist/components/molecules/Language/index.d.ts",
      "import": "./dist/components/molecules/Language/index.js"
    },
    "./media-card": {
      "types": "./dist/components/molecules/MediaCard/index.d.ts",
      "import": "./dist/components/molecules/MediaCard/index.js"
    },
    "./modal": {
      "types": "./dist/components/molecules/Modal/index.d.ts",
      "import": "./dist/components/molecules/Modal/index.js"
    },
    "./snackbar": {
      "types": "./dist/components/molecules/Snackbar/index.d.ts",
      "import": "./dist/components/molecules/Snackbar/index.js"
    },
    "./table": {
      "types": "./dist/components/molecules/Table/index.d.ts",
      "import": "./dist/components/molecules/Table/index.js"
    },
    "./timeline": {
      "types": "./dist/components/molecules/Timeline/index.d.ts",
      "import": "./dist/components/molecules/Timeline/index.js"
    },
    "./use-delayed-unmount": {
      "types": "./dist/hooks/useDelayedUnmount/index.d.ts",
      "import": "./dist/hooks/useDelayedUnmount/index.js"
    },
    "./use-dismissable-layer": {
      "types": "./dist/hooks/useDismissableLayer/index.d.ts",
      "import": "./dist/hooks/useDismissableLayer/index.js"
    },
    "./use-focus-trap": {
      "types": "./dist/hooks/useFocusTrap/index.d.ts",
      "import": "./dist/hooks/useFocusTrap/index.js"
    },
    "./use-media-query": {
      "types": "./dist/hooks/useMediaQuery/index.d.ts",
      "import": "./dist/hooks/useMediaQuery/index.js"
    },
    "./use-merged-ref": {
      "types": "./dist/hooks/useMergedRef/index.d.ts",
      "import": "./dist/hooks/useMergedRef/index.js"
    },
    "./use-scroll-lock": {
      "types": "./dist/hooks/useScrollLock/index.d.ts",
      "import": "./dist/hooks/useScrollLock/index.js"
    },
    "./cn": {
      "types": "./dist/utils/cn/index.d.ts",
      "import": "./dist/utils/cn/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@inzumer/tokens": "workspace:*"
  },
  "peerDependencies": {
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "react": ">=18 || ^19",
    "react-dom": ">=18 || ^19",
    "tailwind-merge": ">=2.0.0"
  },
  "devDependencies": {
    "@inzumer/eslint-config": "workspace:*",
    "@inzumer/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitest/coverage-v8": "^5.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.1",
    "tailwind-merge": "2.6.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  }
}
